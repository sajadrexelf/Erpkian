    organizations {
        uuid id PK
        varchar name
        varchar slug UK
        uuid business_type_id FK
        char base_currency_code FK
        varchar status
    }
    organization_memberships {
        uuid organization_id PK_FK
        uuid id PK
        uuid user_id FK
        uuid default_branch_id FK
        varchar membership_status
    }
    fiscal_periods {
        uuid organization_id PK_FK
        uuid id PK
        uuid fiscal_year_id FK
        int period_number
        date start_date
        date end_date
        char start_jalali
        char end_jalali
        varchar status
    }
    accounting_policies {
        uuid organization_id PK_FK
        uuid id PK
        date effective_from
        varchar accounting_mode
        varchar inventory_valuation_method
        varchar payment_allocation_method
    }
